{
  "name": "gym-challenge-tooling",
  "private": true,
  "description": "Repo-level tooling only (OpenSpec, hooks self-test, secret scan). Frontend has its own package.json in frontend/.",
  "scripts": {
    "spec:check": "node scripts/spec-check.mjs",
    "openspec:pin": "node scripts/openspec-pin.mjs",
    "hooks:selftest": "node scripts/hooks-selftest.mjs",
    "secrets:selftest": "node scripts/secret-scan.mjs --self-test",
    "githooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.0"
  },
  "packageManager": "pnpm@11.17.0"
}
