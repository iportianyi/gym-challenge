# Copy to .env and fill in by hand; .env is git-ignored and never committed.
# Development bot token from @BotFather. Empty: the app runs with local-dev-token (dev links only).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# ngrok account: the authtoken and the static domain, e.g. your-name.ngrok-free.app (docs/telegram-dev.md).
NGROK_AUTHTOKEN=
NGROK_URL=