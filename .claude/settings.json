{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "OPENSPEC_TELEMETRY": "0"
  },
  "permissions": {
    "allow": [
      "Read",
      "Bash(node scripts/agent-log-summary.mjs *)",
      "Bash(node scripts/hooks-selftest.mjs)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(pnpm exec openspec *)",
      "Bash(pnpm spec:check)",
      "Bash(pnpm openspec:pin)",
      "Bash(pnpm agent:log *)",
      "Bash(pnpm hooks:selftest)",
      "Bash(make check)",
      "Bash(node scripts/secret-scan.mjs *)",
      "Bash(pnpm secrets:selftest)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(pnpm add *)",
      "Bash(pnpm install *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-env.mjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/log-action.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/log-action.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/log-action.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["context7", "playwright"]
}
